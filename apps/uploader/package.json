{
  "name": "@sqraft-cloud/uploader",
  "productName": "Sqraft 上传",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "把 .sqraft 设计稿上传到 Sqraft 私有云的桌面客户端",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && vue-tsc -p tsconfig.web.json",
    "dist": "pnpm build && electron-builder --mac --arm64 --publish never"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "5.2.4",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vue": "3.5.44",
    "vue-tsc": "2.2.8"
  }
}
