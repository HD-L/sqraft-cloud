{
  "name": "@sqraft-cloud/server",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:fastify --external:@fastify/cookie --external:better-sqlite3 --external:bcryptjs --external:yauzl --outfile=dist/server.mjs --log-level=warning",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "8.1.1",
    "bcryptjs": "2.4.3",
    "better-sqlite3": "11.8.1",
    "fastify": "5.2.1",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "@sqraft/ai-tools": "workspace:*",
    "@sqraft/core": "workspace:*",
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.20.5",
    "@types/yauzl": "2.10.3",
    "esbuild": "0.25.12",
    "fflate": "0.8.3",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
