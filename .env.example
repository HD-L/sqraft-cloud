# 初始管理员（只在没有任何管理员时生效）
SQRAFT_ADMIN_USER=admin
SQRAFT_ADMIN_PASSWORD=请改成至少8位的强密码

# 对外访问地址
SQRAFT_PUBLIC_URL=https://design.example.com
# 使用 --profile https 时 Caddy 申请证书的域名
SQRAFT_DOMAIN=design.example.com

# 服务端口绑定地址：有反向代理时保持 127.0.0.1；直接对外暴露改成 0.0.0.0
SQRAFT_BIND=127.0.0.1

# 令牌最长有效期（天），0 = 不限
SQRAFT_TOKEN_MAX_DAYS=0
# 回收站保留天数
SQRAFT_TRASH_DAYS=30
# Prometheus 抓取令牌（留空则不开放 /metrics）
SQRAFT_METRICS_TOKEN=
# 自己构建的镜像：SQRAFT_IMAGE=sqraft-cloud:local
